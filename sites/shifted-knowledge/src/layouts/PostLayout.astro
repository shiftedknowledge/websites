---
import siteConfig from "@/site.config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type Post, type Guide, getPostUrl, getGuideUrl, getAllPosts, getRelatedPosts } from "@/utils/content";
import { slugify } from "@/utils/text";
import { getCoverImage } from "@/utils/image";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import SharePost from "@/components/content/SharePost.astro";
import SEO from "@/components/SEO.astro";
import PostNavigation from "@/components/content/PostNavigation.astro";
import { generatePostSchema } from "@/utils/schema";
import PostMeta from "@/components/content/PostMeta.astro";
import RelatedPosts from "@/components/content/RelatedPosts.astro";
import Footer from "@/components/Footer.astro";
import ImageWrapper from "@/components/ImageWrapper.astro";

// Shared by posts and guides. A guide has no place in the timeline, so it gets
// no previous/next navigation and no "more like this" list; everything else
// about rendering a long-form article is identical.
type Props = {
  post: Post | Guide;
  prevPost?: Post | null;
  nextPost?: Post | null;
};

const {
  post,
  prevPost,
  nextPost,
} = Astro.props;

const isGuide = post.collection === "guides";

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
}

function formatMonthYear(date: Date) {
  return new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "long",
  })
    .format(date)
    .toUpperCase();
}
const { title, description, cover, published, tags } = post.data;

const entryUrl = isGuide
  ? getGuideUrl(post.id, post.filePath)
  : getPostUrl(post.id, post.filePath);

// Related posts are a timeline idea. A guide stands on its own.
const relatedPosts = isGuide
  ? []
  : getRelatedPosts(post as Post, await getAllPosts(), siteConfig.relatedPosts);

// The OG route lives beside the page (…/<slug>/index.png.ts), so the image URL
// is the entry URL plus the filename. Keep these in step.
const ogImage = `${entryUrl}/index.png`;
const structuredData = generatePostSchema(post, entryUrl);
const coverImage = getCoverImage(cover, post.filePath);
---

<BaseLayout schema={structuredData}>
  <SEO
    slot="seo"
    {title}
    description={description ?? ""}
    type="article"
    publishedTime={published}
    {tags}
    {ogImage}
  />
  <Fragment slot="header">
    <Breadcrumb title={title} />
    <!-- Post Header -->
    <header class="space-y-4">
      <!-- Title -->
      <h1 
          class="text-3xl leading-tight tracking-tight font-medium md:text-4xl mb-2 text-balance"
          transition:name={slugify(post.data.title.replaceAll(".", "-"))}
      >
          {post.data.title}
      </h1>

      <!-- Description -->
      {
        post.data.description && (
          <p class="max-w-xl text-base text-prettyfont-content italic font-light leading-relaxed text-muted-foreground">
            {post.data.description}
          </p>
        )
      }
      
      <!-- Metadata -->
      <div class="post-meta flex flex-row items-baseline gap-2 mb-3 text-xs font-ui text-muted-foreground">
        <PostMeta
          post={post}
          showReadingTime
          useUpdated={isGuide}
          dateLabel={isGuide ? "Updated" : undefined}
        />
      </div>
      <div class="divider" />
    </header>
  </Fragment>

  <section>
    <!-- Cover -->
    {coverImage && (
      <section class="breakout overflow-hidden rounded-sm ring ring-border shadow-sm">
        <ImageWrapper src={coverImage} alt={title} class="block w-full h-auto" fetchPriority="high" />
      </section>
    )}

    <!-- Post Content -->
    <article class="post-content flex flex-col space-y-2">
      <!-- Rendered markdown -->
	    <div class="app-prose post-content">
	      <slot />
        <hr />
	    </div>
	  </article>

    {/* Post annotation — document-level context, posts only, no footer fallback */}
    {post.data.annotation && (
      <span class="font-annotation block text-primary max-w-70 md:max-w-80 mt-4 text-xl md:text-2xl -rotate-1 leading-snug">
        {post.data.annotation}
      </span>
    )}

    {/* Tags are kept in frontmatter and travel out in the RSS feed, but they
        are not shown or browsable: there is no tag index and no filter to link
        to. /posts is a plain timeline. */}
    <SharePost title={post.data.title} />
    <div class="divider" />
  </section>
  
  {(prevPost || nextPost) && (
    <Fragment slot="navigation">
      <PostNavigation
        prevPost={prevPost}
        nextPost={nextPost}
      />
    </Fragment>
  )}
  <Fragment slot="after">
    {relatedPosts.length > 0 && (
      <RelatedPosts posts={relatedPosts} sectionTitle="More like this"/>
    )}
  </Fragment>
  <Fragment slot="scripts">
    <ReadingProgress />
  </Fragment>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
  
</BaseLayout>
