---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import EntryRow from "@/components/content/EntryRow.astro";
import { getAllGuides, getGuideUrl } from "@/utils/content";

// Guides are reference material, not a timeline: no year buckets, no
// pagination, ordered by when each was last revised.
const guides = await getAllGuides();

const title = "Guides";
const description =
  "Standalone explanations, kept current. Revised as things change, rather than left as written.";
---

<PageLayout {title} {description} showHeader={false}>
  <PageHeader {title} subheading={description} />

  {guides.length > 0 ? (
    <div class="flex flex-col space-y-2">
      {guides.map((guide) => (
        <EntryRow
          post={guide}
          href={getGuideUrl(guide.id, guide.filePath)}
          dateLabel="Updated"
          useUpdated
        />
      ))}
    </div>
  ) : (
    <p class="text-muted-foreground italic">
      No guides published yet.
    </p>
  )}
</PageLayout>
