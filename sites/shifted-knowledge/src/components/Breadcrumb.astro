---
import HomeIcon from "@/assets/home.svg"

interface Props {
  /**
   * The real title of the thing being viewed. Used for the final crumb.
   *
   * Without it the label is derived from the slug and title-cased word by word,
   * which turns "markdown-and-ai" into "Markdown And Ai". Slugs are lossy;
   * the entry knows its own title, so pass it.
   */
  title?: string;
}

const { title } = Astro.props;

const pathname = Astro.url.pathname;

const segments = pathname
  .split("/")
  .filter(Boolean);

const breadcrumbs = segments.map(
  (segment, index) => {
    const href =
      "/" +
      segments
        .slice(0, index + 1)
        .join("/");

    const isLast = index === segments.length - 1;

    const label =
      isLast && title
        ? title
        : decodeURIComponent(segment)
            .replace(/-/g, " ")
            .replace(/\b\w/g, (char) =>
              char.toUpperCase()
            );

    return {
      label,
      href,
    };
  }
);
---

{
  breadcrumbs.length > 0 && (
    <nav
      aria-label="Breadcrumb"
      class="text-muted-foreground flex flex-wrap items-center gap-2 text-xs font-ui my-8"
    >
      <a
        href="/"
        class="flex gap-1 items-center hover:text-foreground transition-colors"
      >
        <HomeIcon class="text-muted-forground size-4"/>
        Home
      </a>

      {breadcrumbs.map(
        (crumb, index) => {
          const isLast =
            index ===
            breadcrumbs.length - 1;

          return (
            <>
              <span
                aria-hidden="true"
                class="text-border"
              >
                /
              </span>

              {isLast ? (
                <span
                  aria-current="page"
                  class="text-primary max-w-[30ch] truncate"
                  title={crumb.label}
                >
                  {crumb.label}
                </span>
              ) : (
                <a
                  href={crumb.href}
                  class="hover:text-foreground transition-colors"
                >
                  {crumb.label}
                </a>
              )}
            </>
          );
        }
      )}
    </nav>
  )
}