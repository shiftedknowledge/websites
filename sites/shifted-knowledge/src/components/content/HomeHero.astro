---
import { getEntry, render } from "astro:content";
import siteConfig from "@/site.config";

const variant = siteConfig.heroVariant;

// The studio variant renders a fixed tagline and needs no page entry. Only the
// prose variant pulls the optional `home-intro` page, so we avoid looking it up
// (and warning when it is absent) unless that variant is in use.
const homeEntry =
  variant === "studio" ? null : await getEntry("pages", "home-intro");
const Content = homeEntry ? (await render(homeEntry)).Content : null;
---
<section class="home-hero flex flex-col pt-8 sm:pt-12" data-pagefind-ignore>
  {variant === "studio" ? (
    <p class="font-content italic text-2xl sm:text-3xl max-w-xl leading-snug tracking-tight wrap-break-word text-foreground">
      Raw vectors, quiet logic.
    </p>
    <div class="h-px bg-border mt-8" />
  ) : (
    <div class="app-prose home-intro-content">
      {Content ? <Content /> : null}
    </div>
  )}
</section>