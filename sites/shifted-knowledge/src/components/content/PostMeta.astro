---
import { type Post, type Guide } from "@/utils/content";
import { calculateReadingTime } from "@/utils/text";
import siteConfig from "@/site.config";

type Props = {
  post: Post | Guide;
  showReadingTime?: boolean;
  showLanguage?: boolean;
  /** Prefix for the date, e.g. "Updated". Guides use it; posts do not. */
  dateLabel?: string;
  /** Show the revision date instead of the publication date. */
  useUpdated?: boolean;
};

const {
  post,
  showReadingTime = false,
  showLanguage = false,
  dateLabel,
  useUpdated = false,
} = Astro.props;

const { published, updated, lang } = post.data;

const date = useUpdated ? (updated ?? published) : published;

const displayDate = new Intl.DateTimeFormat("en", {
  month: "short",
  year: "numeric",
}).format(date);

const readingTime =
  siteConfig.showReadingTime && showReadingTime
    ? calculateReadingTime(post.body ?? "").text
    : null;
---

<time
  datetime={date.toISOString()}
  class="tabular-nums"
>
  {dateLabel ? `${dateLabel} ${displayDate}` : displayDate}
</time>

{
  readingTime && (
    <span>
      {readingTime}
    </span>
  )
}

{
  showLanguage && lang && (
    <span class="uppercase">
      {lang}
    </span>
  )
}
