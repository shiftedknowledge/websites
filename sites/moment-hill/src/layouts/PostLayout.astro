---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
import { entrySlug, type Post } from "@/utils/content";

interface Props {
  post: Post;
  related: Post[];
}
const { post, related } = Astro.props;
const date = post.data.published.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout>
  <SEO
    slot="seo"
    title={post.data.title}
    description={post.data.description}
    type="article"
    publishedTime={post.data.published}
  />
  <article class="wrap-prose py-14 md:py-20">
    <p class="font-ui text-sm uppercase tracking-wide text-muted-foreground">
      <a href="/posts" class="link-hover">Posts</a> · {date}
    </p>
    <h1 class="mt-3 font-display text-4xl text-primary md:text-5xl">{post.data.title}</h1>
    <p class="mt-4 text-lg text-muted-foreground">{post.data.description}</p>

    <div class="app-prose mt-10">
      <slot />
    </div>

    {
      post.data.tags && post.data.tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {post.data.tags.map((t) => (
            <li class="cat-tag">{t}</li>
          ))}
        </ul>
      )
    }
  </article>

  {
    related.length > 0 && (
      <aside class="wrap-prose pb-10">
        <div class="divider" />
        <h2 class="font-content text-xl text-primary">More like this</h2>
        <ul class="mt-4 space-y-4">
          {related.map((p) => (
            <li>
              <a
                href={`/posts/${entrySlug(p.id)}`}
                class="font-content text-lg text-primary link-hover"
              >
                {p.data.title}
              </a>
              <p class="text-sm text-muted-foreground">{p.data.description}</p>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</BaseLayout>
