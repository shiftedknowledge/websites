---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
import type { Tutorial } from "@/utils/content";

interface Props {
  tutorial: Tutorial;
}
const { tutorial } = Astro.props;
const { title, description, level } = tutorial.data;
---

<BaseLayout>
  <SEO
    slot="seo"
    title={title}
    description={description}
    type="article"
    publishedTime={tutorial.data.published}
  />
  <article class="wrap-prose py-14 md:py-20">
    <p class="font-ui text-sm uppercase tracking-wide text-muted-foreground">
      <a href="/tutorials" class="link-hover">Tutorials</a>
    </p>
    <h1 class="mt-3 font-display text-4xl text-primary md:text-5xl">{title}</h1>
    <p class="mt-4 text-lg text-muted-foreground">{description}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      <li class="cat-tag">{level}</li>
    </ul>

    <div class="app-prose mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>
