---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
import type { Framework } from "@/utils/content";

interface Props {
  framework: Framework;
}
const { framework } = Astro.props;
const { title, description, categories, buyUrl, buyLabel } = framework.data;
---

<BaseLayout>
  <SEO
    slot="seo"
    title={title}
    description={description}
    type="article"
    publishedTime={framework.data.published}
  />
  <article class="wrap-prose py-14 md:py-20">
    <p class="font-ui text-sm uppercase tracking-wide text-muted-foreground">
      <a href="/frameworks" class="link-hover">Frameworks</a>
    </p>
    <h1 class="mt-3 font-display text-4xl text-primary md:text-5xl">{title}</h1>
    <p class="mt-4 text-lg text-muted-foreground">{description}</p>
    {
      categories.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {categories.map((c) => (
            <li class="cat-tag">{c}</li>
          ))}
        </ul>
      )
    }

    <div class="app-prose mt-10">
      <slot />
    </div>

    <div class="mt-12 border-t border-border pt-8">
      {
        buyUrl ? (
          <a href={buyUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
            {buyLabel ?? "Get this framework"}
          </a>
        ) : (
          <p class="text-sm text-muted-foreground">Availability coming soon.</p>
        )
      }
    </div>
  </article>
</BaseLayout>
