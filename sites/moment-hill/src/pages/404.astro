---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
---

<BaseLayout>
  <SEO slot="seo" title="Page not found" noindex />
  <section class="wrap py-24 text-center">
    <h1 class="font-display text-5xl text-primary">Not found</h1>
    <p class="mt-4 text-muted-foreground">That page does not exist.</p>
    <a href="/" class="btn-primary mt-8 inline-flex">Back home</a>
  </section>
</BaseLayout>
