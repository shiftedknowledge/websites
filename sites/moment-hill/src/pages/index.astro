---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
import Newsletter from "@/components/Newsletter.astro";
import siteConfig from "@/site.config";
import tyneBridge from "@/assets/tyne-bridge-hero.png";

const home = await getEntry("pages", "home");
const tagline = home?.data.tagline ?? siteConfig.tagline;
const intro = home?.data.intro ?? siteConfig.description;
const offerings = home?.data.offerings ?? [];
const foundation = home?.data.foundation;
---

<BaseLayout>
  <SEO slot="seo" />

  <section>
    <div class="wrap grid items-end gap-8 pt-12 md:grid-cols-2 md:pt-20">
      <div>
        <h1 class="font-display text-4xl leading-tight text-primary md:text-5xl">
          {tagline}
        </h1>
        <p class="mt-6 max-w-prose text-lg text-foreground/90">{intro}</p>
      </div>
      <div>
        <Image
          src={tyneBridge}
          alt="The Tyne Bridge, Newcastle"
          widths={[480, 768, 1024]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="w-full rounded-sm"
        />
      </div>
    </div>
  </section>

  {
    offerings.length > 0 && (
      <section class="wrap pt-6 pb-14 md:pb-20">
        <div class="grid gap-6 md:grid-cols-2">
          {offerings.map((o) => (
            <div class="flex flex-col rounded-sm border border-border bg-card p-8">
              <p class="font-ui text-sm text-muted-foreground">{o.eyebrow}</p>
              <h2 class="mt-1 font-content text-3xl text-primary">{o.title}</h2>
              <p class="mt-3 text-muted-foreground">{o.blurb}</p>
              <a
                href={o.ctaHref}
                class="mt-auto inline-flex w-fit items-center gap-1.5 pt-6 font-ui text-sm font-semibold text-primary link-hover"
              >
                {o.ctaLabel} <span aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>

        {foundation && (
          <div class="mt-6 rounded-sm bg-tyne px-8 py-12 text-center">
            {foundation.label && (
              <p class="font-ui text-xs uppercase tracking-wider text-sage">{foundation.label}</p>
            )}
            <h2 class="mx-auto max-w-3xl font-display text-2xl leading-snug text-stone md:text-3xl">
              {foundation.headline}
            </h2>
            {foundation.blurb && (
              <p class="mx-auto mt-4 max-w-2xl text-stone/80">{foundation.blurb}</p>
            )}
          </div>
        )}
      </section>
    )
  }

  <section class="border-t border-border py-14">
    <Newsletter />
  </section>
</BaseLayout>
