---
// Where Buttondown sends people after they submit the signup form, and again
// after they confirm. Set as `subscription_redirect_url` and
// `subscription_confirmation_redirect_url` on the newsletter.
//
// It exists because the alternative is landing a new subscriber on the bare
// homepage with no acknowledgement, which reads as a form that did nothing.
//
// noindex: this is a destination, not a page anyone should find by search.
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
---

<BaseLayout>
  <SEO slot="seo" title="You're subscribed" noindex />
  <section class="wrap-prose py-24 text-center">
    <h1 class="font-display text-4xl text-primary">Thank you</h1>
    <p class="mt-4 text-muted-foreground">
      Check your inbox for a message asking you to confirm. Nothing arrives
      until you have clicked the link in it.
    </p>
    <p class="mt-3 text-sm text-muted-foreground">
      If it is not there in a few minutes, look in your spam folder.
    </p>
    <a href="/" class="btn-primary mt-8 inline-flex">Back to the site</a>
  </section>
</BaseLayout>
