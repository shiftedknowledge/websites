---
import { render } from "astro:content";
import TutorialLayout from "@/layouts/TutorialLayout.astro";
import { getAllTutorials, entrySlug } from "@/utils/content";

export async function getStaticPaths() {
  const tutorials = await getAllTutorials();
  return tutorials.map((tutorial) => ({
    params: { slug: entrySlug(tutorial.id) },
    props: { tutorial },
  }));
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);
---

<TutorialLayout tutorial={tutorial}>
  <Content />
</TutorialLayout>
