---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
import PostCard from "@/components/PostCard.astro";
import { getAllPosts } from "@/utils/content";

const posts = await getAllPosts();
---

<BaseLayout>
  <SEO
    slot="seo"
    title="Posts"
    description="Working notes on frameworks, AI leverage, and getting strategy delivered."
  />
  <section class="wrap py-14 md:py-20">
    <h1 class="font-display text-4xl text-primary md:text-5xl">Posts</h1>
    <p class="mt-4 max-w-prose text-lg text-muted-foreground">
      Working notes on frameworks, AI leverage, and delivery.
    </p>

    <div class="mt-10 space-y-6">
      {
        posts.length === 0 ? (
          <p class="text-muted-foreground">
            Coming soon. The first pieces are being written.
          </p>
        ) : (
          posts.map((post) => <PostCard post={post} />)
        )
      }
    </div>
  </section>
</BaseLayout>
