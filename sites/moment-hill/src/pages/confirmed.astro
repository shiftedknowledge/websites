---
// Where Buttondown sends people after they click the confirm link in the
// opt-in email. Set as `subscription_confirmation_redirect_url`.
//
// Deliberately separate from /subscribed. Pointing both redirects at one page
// means a confirmed subscriber is told to go and check their inbox for an
// email they have just acted on, which reads as a failure.
//
//   /subscribed  -> "we have sent you something, go and confirm"
//   /confirmed   -> "you are on the list, nothing further to do"
//
// noindex: a destination, not a page anyone should find by search.
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
---

<BaseLayout>
  <SEO slot="seo" title="You're on the list" noindex />
  <section class="wrap-prose py-24 text-center">
    <h1 class="font-display text-4xl text-primary">You're on the list</h1>
    <p class="mt-4 text-muted-foreground">
      That's it, nothing further to do. Occasional notes on frameworks, AI
      leverage, and getting strategy delivered.
    </p>
    <p class="mt-3 text-sm text-muted-foreground">
      Every issue has an unsubscribe link at the bottom.
    </p>
    <a href="/" class="btn-primary mt-8 inline-flex">Back to the site</a>
  </section>
</BaseLayout>
