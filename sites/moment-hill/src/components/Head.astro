---
import "@/styles/global.css";
import siteConfig from "@/site.config";

interface Props {
  schema?: Record<string, unknown>;
}
const { schema } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#EDEEE6" />

  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${siteConfig.title} · Posts`}
    href="/rss.xml"
  />

  <!-- Preload the fonts most needed for first paint. -->
  <link rel="preload" href="/fonts/LibertinusSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/LibertinusSerif-Bold.woff2" as="font" type="font/woff2" crossorigin />

  <!-- SEO injected per page -->
  <slot name="seo" />

  {
    schema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    )
  }

  <slot name="head" />
</head>
