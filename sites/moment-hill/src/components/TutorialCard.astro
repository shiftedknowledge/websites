---
import type { Tutorial } from "@/utils/content";
import { entrySlug } from "@/utils/content";

interface Props {
  tutorial: Tutorial;
}
const { tutorial } = Astro.props;
const href = `/tutorials/${entrySlug(tutorial.id)}`;
const level = tutorial.data.level;
---

<article class="card-item" data-level={level}>
  <a href={href} class="group block no-underline">
    <h3 class="font-content text-xl text-primary group-hover:underline">
      {tutorial.data.title}
    </h3>
    <p class="mt-2 text-muted-foreground">{tutorial.data.description}</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      <li class="cat-tag">{level}</li>
    </ul>
  </a>
</article>
