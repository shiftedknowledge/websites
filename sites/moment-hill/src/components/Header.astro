---
import { Image } from "astro:assets";
import siteConfig from "@/site.config";
import logoHorizontal from "@/assets/logo-horizontal.png";

const pathname = Astro.url.pathname;
const isActive = (url: string) =>
  url === "/" ? pathname === "/" : pathname.startsWith(url);
---

<header class="border-b border-border bg-background">
  <div class="wrap flex min-h-16 items-center justify-between py-3">
    <a href="/" class="flex items-center" aria-label={`${siteConfig.title}, home`}>
      {/*
        The source is 5342px wide and this renders at ~229px (h-8, aspect 7.16).
        Declaring the source dimensions made Astro advertise sizes="…100vw", so
        a retina browser fetched a near-full-size logo on every page. 716px is
        3x the largest rendered width, which is as much as any display needs.
      */}
      <Image
        src={logoHorizontal}
        alt="Moment Hill"
        width={716}
        height={100}
        sizes="229px"
        class="h-7 w-auto sm:h-8"
      />
    </a>

    <div class="flex items-center gap-5">
      <nav class="hidden items-center gap-6 text-[0.95rem] sm:flex">
        {
          siteConfig.navigation.map((item) => (
            <a
              href={item.url}
              class="nav-link"
              aria-current={isActive(item.url) ? "page" : undefined}
            >
              {item.title}
            </a>
          ))
        }
      </nav>

      <a
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-btn"
        aria-label={`${siteConfig.author} on LinkedIn`}
        title="LinkedIn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.65 4.78 6.1V21H17.6v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z" />
        </svg>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="icon-btn sm:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg width="16" height="16" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="1" y1="3.5" x2="13" y2="3.5" />
          <line x1="1" y1="7" x2="13" y2="7" />
          <line x1="1" y1="10.5" x2="13" y2="10.5" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-drawer" class="sm:hidden" hidden>
    <nav class="border-t border-border">
      {
        siteConfig.navigation.map((item) => (
          <a
            href={item.url}
            class="block border-b border-border px-5 py-3.5 font-ui text-base text-foreground aria-[current=page]:text-primary"
            aria-current={isActive(item.url) ? "page" : undefined}
          >
            {item.title}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("mobile-drawer");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    if (drawer) drawer.hidden = open;
  });
</script>
