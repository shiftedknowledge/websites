---
import type { Explainer } from "@/utils/content";
import { entrySlug } from "@/utils/content";

interface Props {
  explainer: Explainer;
}
const { explainer } = Astro.props;
const href = `/explainers/${entrySlug(explainer.id)}`;
const level = explainer.data.level;
---

<article class="card-item" data-level={level}>
  <a href={href} class="group block no-underline">
    <h3 class="font-content text-xl text-primary group-hover:underline">
      {explainer.data.title}
    </h3>
    <p class="mt-2 text-muted-foreground">{explainer.data.description}</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      <li class="cat-tag">{level}</li>
    </ul>
  </a>
</article>
