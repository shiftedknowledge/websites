# Build + tooling artefacts (never committed)
node_modules/
dist/
.astro/
**/public/pagefind/

# Content is assembled in from a separate content repo (build-site.sh / dev-link.sh);
# it must never be committed into the infrastructure repo. No trailing slash, so
# this also ignores the dev-link symlink (git sees a symlink as a file, not a dir).
sites/*/src/content

# The throwaway infra clone Cloudflare makes during a build.
.infra/

# Local env + OS + editor cruft
.env
.env.production
.DS_Store
.idea/
.vscode/

# Per-machine Claude Code settings (the skill and launch.json DO belong in git).
.claude/settings.local.json
